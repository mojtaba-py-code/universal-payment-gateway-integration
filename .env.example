# ---------------------------------------------------------------------------
# Universal Payment Gateway Integration — example environment.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Generate strong secrets with:  python -m app generate-key
# ---------------------------------------------------------------------------

# -- General ----------------------------------------------------------------
UPGI_ENVIRONMENT=local            # local | testing | staging | production
UPGI_DEBUG=false
UPGI_APP_NAME=Universal Payment Gateway Integration

# -- Database (async SQLAlchemy URL) ----------------------------------------
# Local default is SQLite; production should use PostgreSQL + asyncpg:
# UPGI_DATABASE_URL=postgresql+asyncpg://upgi:upgi@db:5432/upgi
UPGI_DATABASE_URL=sqlite+aiosqlite:///./upgi.db

# -- Cache / queue ----------------------------------------------------------
UPGI_REDIS_URL=redis://redis:6379/0
UPGI_USE_REDIS=false

# -- Security ---------------------------------------------------------------
# 32+ character random string.
UPGI_JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret_string_min_32_chars
UPGI_ACCESS_TOKEN_TTL_SECONDS=900
UPGI_REFRESH_TOKEN_TTL_SECONDS=604800

# Base64url-encoded 32-byte AES master key (run `python -m app generate-key`).
UPGI_SECRET_ENCRYPTION_KEY=CHANGE_ME_base64url_32_bytes

# -- Rate limiting ----------------------------------------------------------
UPGI_RATE_LIMIT_ENABLED=true
UPGI_RATE_LIMIT_REQUESTS=120
UPGI_RATE_LIMIT_WINDOW_SECONDS=60

# -- Webhooks ---------------------------------------------------------------
UPGI_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# -- CORS (JSON array) ------------------------------------------------------
UPGI_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# -- Observability ----------------------------------------------------------
UPGI_LOG_LEVEL=INFO
UPGI_LOG_JSON=true
UPGI_METRICS_ENABLED=true
